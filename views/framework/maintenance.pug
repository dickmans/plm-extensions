doctype html
html
    head
        title Server Update in Progress
        meta(name='viewport' content='width=device-width, initial-scale=1.0, user-scalable=no')
        meta(charset='utf-8')
        style.
            body {
                margin          : 0;
                height          : 100vh;
                display         : flex;
                align-items     : center;
                justify-content : center;
                background      : #fff;
                color           : #333;
                font-family     : -apple-system, Segoe UI, Roboto, sans-serif;
            }
            .box {
                max-width  : 420px;
                padding    : 32px;
                text-align : center;
            }
            h1 {
                font-size : 24px;
                margin    : 0 0 16px 0;
            }
            p {
                font-size   : 14px;
                line-height : 1.6;
                opacity     : 0.8;
                margin      : 0;
            }
            .spinner {
                width            : 30px;
                height           : 30px;
                margin           : 20px auto;
                border           : 3px solid rgba(66,66,66,0.2);
                border-top-color : #0696d7;
                border-radius    : 50%;
                animation        : spin 1s linear infinite;
            }
            @keyframes spin { to { transform : rotate(360deg); } }
            button {
                margin-top    : 20px;
                padding       : 10px 22px;
                border        : none;
                border-radius : 4px;
                background    : #0696d7;
                color         : #ffffff;
                font-size     : 14px;
                cursor        : pointer;
            }
            button:hover {
                background : #007fc6;
            }
            #status {
                font-size  : 12px;
                opacity    : 0.6;
                margin-top : 12px;
            }
    body
        .box
            .spinner
            h1 Server Update in Progress
            p This server is being updated with the latest code from GitHub.
            p= 'It should be back online in about ' + etaMinutes + ' minutes.'
            p This page will reload automatically once the server responds again.
            button#retry Retry Now
            #status Checking…

        script.
            (function() {

                let target = window.location.href;
                let status = document.getElementById('status');
                let button = document.getElementById('retry');
                let timer  = null;

                function check() {

                    status.textContent = 'Checking…';

                    fetch(target, { method : 'GET', cache : 'no-store' }).then(function(response) {

                        if(response.status !== 503) {
                            status.textContent = 'Server is back — reloading…';
                            window.location.reload();
                        } else {
                            status.textContent = 'Still updating…';
                            scheduleRetry();
                        }

                    }).catch(function() {

                        status.textContent = 'Server not reachable yet…';
                        scheduleRetry();

                    });

                }
                function scheduleRetry() {

                    if(timer) clearTimeout(timer);
                    timer = setTimeout(check, 4000);

                }

                button.addEventListener('click', function() { check(); });

                scheduleRetry();

            })();
