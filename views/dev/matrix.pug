extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/dev/matrix.css')
    //- link(rel='stylesheet', href='/stylesheets/custom/matrix.css')

    script(src='/javascripts/dev/matrix.js')
    //- script(src='/javascripts/custom/matrix.js')

block body

    body.surface-level-1.no-details
        
        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle
            #header-toolbar
                #create-button.button.with-icon.icon-create(title='Click to create new validation process for selected requirements') New Validation
                #toggle-details.button.with-toggle.toggle-off(title='Toggle Details panel on/off') Details
                #header-avatar
        
        #main.screen

            #tree.surface-level-1
            #details.surface-level-2.pos-abs-right
            #related.surface-level-2.pos-abs-bottom

            #create.dialog