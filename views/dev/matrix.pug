extends ../framework/layout

block head

    link(rel='stylesheet', href='/stylesheets/dev/matrix.css')
    //- link(rel='stylesheet', href='/stylesheets/custom/matrix.css')

    script(src='/javascripts/dev/matrix.js')
    //- script(src='/javascripts/custom/matrix.js')

block body

    body.surface-level-1.no-details
        
        #header.dark
            #header-logo
            #header-title= title
            #header-subtitle
            #header-toolbar
                #create-button.button.with-icon.icon-add.hidden.default
                #toggle-details.button.with-toggle.toggle-off(title='Toggle Details panel on/off') Details Panel
                #header-avatar
        
        #main.screen

            #tree.surface-level-1
            #details.surface-level-2.pos-abs-right
            #status-bar.surface-level-1.pos-abs-bottom.hidden
                #status-bar-failure(title="Click to filter / reset filter")
                    .status-bar-counter 
                    .status-bar-label
                #status-bar-missing(title="Click to filter / reset filter")
                    .status-bar-counter 
                    .status-bar-label
                #status-bar-pending(title="Click to filter / reset filter")
                    .status-bar-counter 
                    .status-bar-label
                #status-bar-success(title="Click to filter / reset filter")
                    .status-bar-counter 
                    .status-bar-label

            #create.dialog