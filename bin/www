#!/usr/bin/env node

const fs  = require('fs');
const app = require('../app');

if(typeof app.locals === 'undefined') return;

let server, port;

if(app.locals.protocol === 'https') {

	if (fs.existsSync('./keys/privkey.pem')) {

		const https       = require('https');
		const privateKey  = fs.readFileSync('./keys/privkey.pem', 'utf8');
		const certificate = fs.readFileSync('./keys/fullchain.pem', 'utf8');
		const credentials = { key: privateKey, cert: certificate };

		server = https.createServer(credentials, app);

	} else {

		console.log();
		console.log('  ERROR ! File privkey.pem not available in folder /keys');
		console.log('        ! Server will be started using http instead of https');
		console.log();

		const http = require('http');

		server = http.createServer(app);

	}

} else {

	const http = require('http');
	server = http.createServer(app);

}

app.set('port', app.locals.port);

app.locals.httpServer = server;

server.listen(app.locals.port);
server.on('error', onError);
server.on('listening', onListening);


if(!fs.existsSync('storage'      )) fs.mkdirSync('storage'      );
if(!fs.existsSync('storage/cache')) fs.mkdirSync('storage/cache');


/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
	if (error.syscall !== 'listen') {
		throw error;
	}

	var bind = typeof port === 'string'
		? 'Pipe ' + port
		: 'Port ' + port;

	// handle specific listen errors with friendly messages
	switch (error.code) {
		case 'EACCES':
			console.error(bind + ' requires elevated privileges');
			process.exit(1);
			break;
		case 'EADDRINUSE':
			console.error(bind + ' is already in use');
			process.exit(1);
			break;
		default:
			throw error;
	}
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {

	let addr = server.address();
	let bind = typeof addr === 'string'
	? 'pipe ' + addr
	: 'port ' + addr.port;

	let startupInfo = buildStartupInfoLines(bind);

	startupInfo.forEach(function(line) { console.log(line); });

	app.locals.startupInfo = startupInfo.join(';');

}

function buildStartupInfoLines(bind) {

	let lines = [];

	lines.push('');
	lines.push('  >> Using PLM Tenant       ' + app.locals.tenant);
	lines.push('  >> Using Client ID        ' + app.locals.clientId.substring(0, 8) + '...');
	lines.push('  >> Using redirect Uri     ' + app.locals.redirectUri);
	lines.push('  >> Using environment file ' + app.locals.environment);
	lines.push('  >> Using settings file    ' + app.locals.settings);
	lines.push('  >> Using Default Theme    ' + app.locals.defaultTheme);
	lines.push('  >> Cache Enabled?         ' + app.locals.enableCache);
	lines.push('  >> Debug Mode Enabled?    ' + app.locals.debugMode);
	lines.push('  >> Fusion Connected?      ' + app.locals.fusionConnected);
	lines.push('  >> Listening on           ' + bind);

	if((app.locals.adminClientId === '') || (app.locals.adminClientSecret === '')) {
		lines.push('');
		lines.push('  The USER SETTINGS MANAGER cannot be used as Admin Client ID/Secret is missing');
	} else {
		lines.push('  >> Using Admin Client ID  ' + app.locals.adminClientId.substring(0, 8) + '...');
		if((app.locals.ssaAccountId !== ''))  {
			lines.push('  >> Using SAA Account ID   ' + app.locals.ssaAccountId);
		}
		if((app.locals.ssaKeyId !== ''))  {
			lines.push('  >> Using SSA Key ID       ' + app.locals.ssaKeyId.substring(0,4) + '...');
		}
		if((app.locals.ssaPrivateKey !== ''))  {
			lines.push('  >> Using SSA Private Key  ' + app.locals.ssaPrivateKey.substring(0,42).replaceAll('\n', '') + '...');
		}
	}

	if(app.locals.monitoringSecret !== '') {
		lines.push('  >> Server Monitoring      enabled by monitoring secret');
	} else {
		lines.push('  >> Server Monitoring      disabled (no secret defined)');
	}

	if((app.locals.vaultGateway === '') || (app.locals.vaultGateway === '')) {
		lines.push('');
		lines.push('  Not connected to Vault as Vault Gateway and/or Vault Name are not defined');
	} else {
		lines.push('  >> Using Vault Gateway    ' + app.locals.vaultGateway);
		lines.push('  >> Using Vault Name       ' + app.locals.vaultName);
	}

	if(typeof app.locals.chrome === 'undefined') {
		lines.push('');
		lines.push('  !! The CHROME EXTENSION cannot be used as exports.chrome does not exist in settings');
	}

	if(app.locals.adminClientId !== '') {
		if(app.locals.adminClientSecret !== '') {
			if(app.locals.ssaAccountId !== '') {
				if(app.locals.ssaKeyId !== '') {
					if(app.locals.ssaPrivateKey !== '') {
						lines.push('');
						lines.push('  Secure Service Account can be used as Admin Client ID/Secret, SSA Account ID, Key ID and Private Key are all defined');
					}
				}
			}
		}
	}

	lines.push('');
	lines.push('');
	lines.push('  REMINDERS');
	lines.push(' --------------------------------------------------------------------------------------------------');
	lines.push('  Since the release of July 2024, the UX server uses PKCE for authentication instead of the');
	lines.push('  former mechanism involving the Client Secret. This requries an APS application of type');
	lines.push('  "Desktop, Mobile, Single-Page App" for successful authentication.');
	lines.push('  ');
	lines.push('  If not done so yet, create such an app at aps.autodesk.com and provide the given ');
	lines.push('  Client ID in file environments.js. This app must use a callback URL that end with "/callback"');
	lines.push('  (i.e. http://localhost:8080/callback).');
	lines.push('  ');
	lines.push('  If your login to the UX solutions fails with an error code 401, you most likely are');
	lines.push('  using an APS of wrong type or with wrong callback URL.');
	lines.push('');
	lines.push('');

	return lines;

}